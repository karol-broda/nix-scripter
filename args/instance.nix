# The generator on its own, for scripts not built by nix-scripter:
#
#   scripter.args.generate { spec = ./args.toml; name = "deploy"; }
#
# yields parser.bash (defines `args_parse`), help.txt, ir.json and completions.
{
  lib,
  pkgs,
  registry,
}:
let
  args = import ./. { inherit lib; };
  util = import ../lib/util.nix { inherit lib; };

  importSpecFile =
    path:
    if lib.hasSuffix ".toml" (toString path) then
      lib.importTOML path
    else if lib.hasSuffix ".json" (toString path) then
      lib.importJSON path
    else
      import path;

  asModule =
    spec:
    let
      value = if lib.isPath spec || lib.isString spec then importSpecFile spec else spec;
    in
    if lib.isFunction value then value else { config = value; };

  evalSpec =
    spec:
    (lib.evalModules {
      modules = [
        args.types.root
        (asModule spec)
      ];
    }).config;

  newestTarget = backend: lib.last (lib.attrNames backend.targets);

  ir =
    {
      spec,
      name ? "script",
      version ? "0.0.0",
      description ? "",
      lang ? "bash",
      target ? null,
    }:
    let
      backend = registry.backends.${lang};
      config = evalSpec spec;
      style =
        if config.vars.style != null then
          config.vars.style
        else
          backend.argsStyle (if target != null then target else newestTarget backend);
      result = args.ir.build {
        inherit
          name
          version
          description
          style
          ;
        spec = config;
      };
    in
    if result.errors == [ ] then
      result.ir
    else
      throw "nix-scripter args:\n${util.bulletList result.errors}";

  generate =
    {
      name ? "script",
      version ? "0.0.0",
      lang ? "bash",
      ...
    }@options:
    let
      theIR = ir options;
      code = registry.backends.${lang}.argsCodegen { ir = theIR; };
    in
    pkgs.runCommandLocal "${name}-args"
      {
        parser = ''
          # argument parser for ${name}, generated by nix-scripter
          __scripter_name=${util.shellQuote name}
          __scripter_version=${util.shellQuote version}
          ${code.parser}
          args_parse() {
            ${code.invoke}
          }
        '';
        help = args.help.render theIR theIR.root;
        bash = args.completions.bash theIR;
        zsh = args.completions.zsh theIR;
        fish = args.completions.fish theIR;
        ir = builtins.toJSON theIR;
        passAsFile = [
          "parser"
          "help"
          "bash"
          "zsh"
          "fish"
          "ir"
        ];
      }
      ''
        mkdir -p $out/completions
        cp "$parserPath" $out/parser.${lang}
        cp "$helpPath" $out/help.txt
        cp "$irPath" $out/ir.json
        cp "$bashPath" $out/completions/${name}.bash
        cp "$zshPath" $out/completions/_${name}
        cp "$fishPath" $out/completions/${name}.fish
      '';
in
{
  inherit ir evalSpec generate;
}
