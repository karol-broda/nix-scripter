# The argument parser generator on its own, for scripts not built by
# nix-scripter:
#
#   scripter.args.generate { spec = ./args.toml; name = "deploy"; }
#     → $out/parser.bash, $out/help.txt, $out/completions/{bash,zsh,fish}
#
# A hand-written script then does: source parser.bash; args_parse "$@"
{
  lib,
  pkgs,
  registry,
}:
let
  argsIR = import ./ir.nix { inherit lib; };
  help = import ./help.nix { inherit lib; };
  completions = import ./completions.nix { inherit lib; };

  load = spec: if lib.isPath spec || lib.isString spec then loadFile spec else spec;
  loadFile =
    path:
    if lib.hasSuffix ".toml" (toString path) then
      lib.importTOML path
    else if lib.hasSuffix ".json" (toString path) then
      lib.importJSON path
    else
      import path;

  evalSpec =
    spec:
    (lib.evalModules {
      modules = [
        (import ./types.nix { inherit lib; }).root
        (load spec)
      ];
    }).config;

  ir =
    {
      spec,
      name ? "script",
      version ? "0.0.0",
      description ? "",
      lang ? "bash",
      target ? null,
    }:
    let
      backend = registry.backends.${lang};
      config = evalSpec spec;
      targetName = if target != null then target else lib.last (lib.attrNames backend.targets);
      style = if config.vars.style != null then config.vars.style else backend.argsStyle targetName;
      result = argsIR.ir {
        inherit
          name
          version
          description
          style
          ;
        spec = config;
      };
    in
    if result.errors == [ ] then
      result.ir
    else
      throw "nix-scripter args:\n${lib.concatMapStringsSep "\n" (e: "  - ${e}") result.errors}";
in
{
  inherit ir evalSpec;

  generate =
    {
      spec,
      name ? "script",
      version ? "0.0.0",
      description ? "",
      lang ? "bash",
      target ? null,
    }@args:
    let
      theIR = ir args;
      code = registry.backends.${lang}.argsCodegen { ir = theIR; };
      q = lib.escapeShellArg;
    in
    pkgs.runCommandLocal "${name}-args"
      {
        parser = ''
          # argument parser for ${name} — generated by nix-scripter
          __scripter_name=${q name}
          __scripter_version=${q version}
          ${code.parser}
          args_parse() {
            __scripter_args_parse_root "$@"
            __scripter_args_export
          }
        '';
        help = help.render theIR theIR.root;
        bash = completions.bash theIR;
        zsh = completions.zsh theIR;
        fish = completions.fish theIR;
        ir = builtins.toJSON theIR;
        passAsFile = [
          "parser"
          "help"
          "bash"
          "zsh"
          "fish"
          "ir"
        ];
      }
      ''
        mkdir -p $out/completions
        cp "$parserPath" $out/parser.${lang}
        cp "$helpPath" $out/help.txt
        cp "$irPath" $out/ir.json
        cp "$bashPath" $out/completions/${name}.bash
        cp "$zshPath" $out/completions/_${name}
        cp "$fishPath" $out/completions/${name}.fish
      '';
}
