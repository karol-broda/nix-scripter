{ lib }:
let
  inherit (lib) concatStringsSep optional optionalString;
  q = lib.escapeShellArg;
  common = import ./common.nix { inherit lib; };
  argument = import ../ir/argument.nix { inherit lib; };

  ancestorsOf =
    levels: level:
    lib.genList (i: lib.findFirst (l: l.path == lib.take (i + 1) level.path) null levels) (
      lib.length level.path
    );

  condition =
    levels: level:
    let
      seen = map (a: "__fish_seen_subcommand_from ${concatStringsSep " " (common.commandNames a)}") (
        ancestorsOf levels level
      );
      childNames = lib.concatMap common.commandNames (common.commands level);
      notInChild = optional (
        childNames != [ ]
      ) "not __fish_seen_subcommand_from ${concatStringsSep " " childNames}";
      parts = seen ++ notInChild;
    in
    optionalString (parts != [ ]) "-n ${q (concatStringsSep "; and " parts)} ";

  valueArguments =
    a:
    if a.complete != null then
      " -x -a ${q "(${a.complete} 2>/dev/null)"}"
    else if a.values != null then
      " -x -a ${q (concatStringsSep " " a.values)}"
    else if argument.isFileLike a || argument.isDir a then
      " -r -F"
    else
      " -x";

  describe = d: optionalString (d != "") " -d ${q d}";

  levelLines =
    ir: prefix: level:
    let
      positionals = common.positionals level;
      enumValues = common.enumValues positionals;
      optionLine =
        a:
        "${prefix}${optionalString (a.short != null) "-s ${a.short} "}-l ${a.long}"
        + optionalString (argument.takesValue a) (valueArguments a)
        + describe a.description;
    in
    map optionLine (common.options level)
    ++ map (a: "${prefix}-l no-${a.long}${describe "Negate --${a.long}"}") (
      lib.filter (a: a.kind == "flag" && a.negatable) (common.options level)
    )
    ++ optional ir.globals.help "${prefix}-s h -l help -d 'Print help'"
    ++ optional (ir.globals.version && level.isRoot) "${prefix}-l version -d 'Print version'"
    ++ map (
      c: "${prefix}-a ${q (concatStringsSep " " (common.commandNames c))}${describe c.description}"
    ) (common.commands level)
    ++ optional (enumValues != [ ]) "${prefix}-a ${q (concatStringsSep " " enumValues)}"
    ++ map (p: "${prefix}-a ${q "(${p.complete} 2>/dev/null)"}") (
      lib.filter (p: p.complete != null) positionals
    )
    ++ optional (lib.any (p: argument.isFileLike p || argument.isDir p) positionals) "${prefix}-F";
in
ir:
let
  levels = common.levelsOf ir.root;
  complete = "complete -c ${q ir.name}";
in
''
  # fish completion for ${ir.name}, generated by nix-scripter
  ${complete} -f
  ${concatStringsSep "\n" (
    lib.concatMap (level: levelLines ir "${complete} ${condition levels level}" level) levels
  )}
''
