{ lib }:
let
  inherit (lib)
    concatMapStringsSep
    concatStringsSep
    filter
    optional
    optionalString
    ;
  q = lib.escapeShellArg;
  common = import ./common.nix { inherit lib; };
  argument = import ../ir/argument.nix { inherit lib; };

  optionWords =
    ir: level:
    lib.concatMap (
      a:
      [ "--${a.long}" ]
      ++ optional (a.short != null) "-${a.short}"
      ++ optional (a.kind == "flag" && a.negatable) "--no-${a.long}"
    ) (common.options level)
    ++ optional ir.globals.help "--help"
    ++ optional (ir.globals.version && level.isRoot) "--version";

  spellings = a: [ "--${a.long}" ] ++ optional (a.short != null) "-${a.short}";
  valued = level: filter argument.takesValue (common.options level);
  casePatterns = level: words: concatMapStringsSep "|" (w: "${level.id}:${w}") words;

  valueCompletion =
    a:
    if a.complete != null then
      ''COMPREPLY=($(compgen -W "$(${a.complete} 2>/dev/null)" -- "$cur"))''
    else if a.values != null then
      "COMPREPLY=($(compgen -W ${q (concatStringsSep " " a.values)} -- \"$cur\"))"
    else if argument.isDir a then
      ''COMPREPLY=($(compgen -d -- "$cur"))''
    else if argument.isFileLike a then
      ''COMPREPLY=($(compgen -f -- "$cur"))''
    else
      ":";

  commandTransitions =
    level:
    map (c: "      ${casePatterns level (common.commandNames c)}) level=${c.id} ;;") (
      common.commands level
    );

  valueSkips =
    levels:
    let
      patterns = lib.concatMap (
        level: map (w: "${level.id}:${w}") (lib.concatMap spellings (valued level))
      ) levels;
    in
    optionalString (patterns != [ ]) "      ${concatStringsSep "|" patterns}) ((i++)) ;;";

  valueCases =
    level:
    map (a: "    ${casePatterns level (spellings a)}) ${valueCompletion a}; return ;;") (valued level);

  levelCandidates =
    ir: level:
    let
      positionals = common.positionals level;
      dynamic = lib.findFirst (p: p.complete != null) null positionals;
      fileKind =
        if lib.any argument.isFileLike positionals then
          "f"
        else if lib.any argument.isDir positionals then
          "d"
        else
          "";
      words = lib.concatMap common.commandNames (common.commands level) ++ common.enumValues positionals;
    in
    ''
      ${level.id})
        opts=${q (concatStringsSep " " (optionWords ir level))}
        words=${q (concatStringsSep " " words)}
        ${optionalString (dynamic != null) ''words="$words $(${dynamic.complete} 2>/dev/null)"''}
        files=${if fileKind == "" then "\"\"" else fileKind}
        ;;'';
in
ir:
let
  fn = common.functionName ir.name "complete";
  levels = common.levelsOf ir.root;
in
''
  # bash completion for ${ir.name}, generated by nix-scripter
  ${fn}() {
    local cur prev level=root i w opts="" words="" files=""
    cur=''${COMP_WORDS[COMP_CWORD]}
    prev=''${COMP_WORDS[COMP_CWORD-1]}
    for ((i = 1; i < COMP_CWORD; i++)); do
      w=''${COMP_WORDS[i]}
      case "$level:$w" in
  ${concatStringsSep "\n" (lib.concatMap commandTransitions levels)}
  ${valueSkips levels}
      esac
    done
    case "$level:$prev" in
  ${concatStringsSep "\n" (lib.concatMap valueCases levels)}
    esac
    case $level in
  ${concatMapStringsSep "\n" (levelCandidates ir) levels}
    esac
    if [[ $cur == -* ]]; then
      COMPREPLY=($(compgen -W "$opts" -- "$cur"))
    else
      COMPREPLY=($(compgen -W "$words" -- "$cur"))
      case $files in
        f) COMPREPLY+=($(compgen -f -- "$cur")) ;;
        d) COMPREPLY+=($(compgen -d -- "$cur")) ;;
      esac
    fi
  }
  complete -F ${fn} ${q ir.name}
''
