{ lib }:
let
  inherit (lib)
    concatMapStringsSep
    concatStringsSep
    optional
    optionalString
    ;
  q = lib.escapeShellArg;
  common = import ./common.nix { inherit lib; };
  argument = import ../ir/argument.nix { inherit lib; };

  escape = lib.replaceStrings [ "\\" "[" "]" ":" "'" ] [ "\\\\" "\\[" "\\]" "\\:" "'\\''" ];
  escapeQuotes = lib.replaceStrings [ "'" ] [ "'\\''" ];

  action =
    a:
    if a.complete != null then
      "{compadd -- \${(f)\"$(${escapeQuotes a.complete} 2>/dev/null)\"}}"
    else if a.values != null then
      "(${concatStringsSep " " (map escape a.values)})"
    else if argument.isDir a then
      "_files -/"
    else if argument.isFileLike a then
      "_files"
    else
      " ";

  repeatable = a: a.repeated || a.count;

  optionNames =
    a:
    if argument.takesValue a then
      (if a.short != null then "{-${a.short}+,--${a.long}=}" else "--${a.long}=")
    else if a.short != null then
      "{-${a.short},--${a.long}}"
    else
      "--${a.long}";

  optionSpec =
    a:
    let
      exclusion =
        if repeatable a then
          "'*'"
        else if a.short != null then
          "'(-${a.short} --${a.long})'"
        else
          "";
      value = optionalString (argument.takesValue a) ":${escape a.metavar}:${action a}";
    in
    [ "${exclusion}${optionNames a}'[${escape a.description}]${value}'" ]
    ++ optional (a.kind == "flag" && a.negatable) "'--no-${a.long}[${escape "Negate --${a.long}"}]'";

  positionalSpec =
    i: p:
    if p.variadic then
      "'*:${escape p.metavar}:${action p}'"
    else
      "'${optionalString p.optional ":"}${toString i}:${escape p.metavar}:${action p}'";

  commandEntries =
    level:
    concatMapStringsSep " " (
      c:
      concatMapStringsSep " " (n: q "${n}:${lib.replaceStrings [ ":" ] [ "\\:" ] c.description}") (
        common.commandNames c
      )
    ) (common.commands level);

  commandDispatch =
    ir: level:
    concatMapStringsSep "\n" (
      c:
      "          ${concatStringsSep "|" (common.commandNames c)}) ${common.functionName ir.name c.id} ;;"
    ) (common.commands level);

  levelFunction =
    ir: level:
    let
      hasCommands = common.commands level != [ ];
      specs =
        lib.concatMap optionSpec (common.options level)
        ++ optional ir.globals.help "'(- *)'{-h,--help}'[Print help]'"
        ++ optional (ir.globals.version && level.isRoot) "'(- *)--version[Print version]'"
        ++ lib.imap1 positionalSpec (common.positionals level)
        ++ lib.optionals hasCommands [
          "'1: :->command'"
          "'*:: :->args'"
        ];
    in
    ''
      ${common.functionName ir.name level.id}() {
        local context state state_descr line
        typeset -A opt_args
        _arguments -s -S -C \
          ${concatStringsSep " \\\n    " specs}
      ${optionalString hasCommands ''
          case $state in
            command)
              local -a commands=(${commandEntries level})
              _describe -t commands 'command' commands
              ;;
            args)
              case $line[1] in
        ${commandDispatch ir level}
              esac
              ;;
          esac''}
      }
    '';
in
ir: ''
  #compdef ${ir.name}
  # zsh completion for ${ir.name}, generated by nix-scripter

  ${concatMapStringsSep "\n" (levelFunction ir) (common.levelsOf ir.root)}
  ${common.functionName ir.name "root"} "$@"
''
