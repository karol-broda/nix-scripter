# Static shell completions generated from the IR. Dynamic completion
# (`complete = "<cmd>"`) is opt-in per argument and runs that command.
{ lib }:
let
  inherit (lib)
    concatMapStringsSep
    concatStringsSep
    filter
    optional
    optionalString
    ;

  q = lib.escapeShellArg;

  visible = filter (a: !a.hidden);
  argsOf = level: visible (level.inherited ++ level.flags ++ level.options);
  commandsOf = level: filter (c: !c.hidden) level.commands;
  namesOf = c: [ c.name ] ++ c.aliases;
  fnName = prog: id: "_${lib.replaceStrings [ "-" "." "+" ] [ "_" "_" "_" ] prog}_${id}";

  isFileType =
    a:
    lib.elem (a.type or "") [
      "path"
      "file"
    ];
  isDirType = a: (a.type or "") == "dir";

  levelsOf = level: [ level ] ++ lib.concatMap levelsOf level.commands;

  # ---------------------------------------------------------------- bash --
  bash =
    ir:
    let
      fn = fnName ir.name "complete";
      levels = levelsOf ir.root;
      transitions = lib.concatMap (
        level:
        map (
          c: "      ${level.id}:${concatStringsSep "|${level.id}:" (namesOf c)}) __scripter_level=${c.id} ;;"
        ) (commandsOf level)
      ) levels;
      valueOpts = lib.concatMap (
        level:
        map (a: "${level.id}:--${a.long}") (filter (a: a.kind == "option") (argsOf level))
        ++ map (a: "${level.id}:-${a.short}") (
          filter (a: a.kind == "option" && a.short != null) (argsOf level)
        )
      ) levels;
      valueAction =
        a:
        if a.complete != null then
          ''COMPREPLY=($(compgen -W "$(${a.complete} 2>/dev/null)" -- "$cur"))''
        else if a.values != null then
          "COMPREPLY=($(compgen -W ${q (concatStringsSep " " a.values)} -- \"$cur\"))"
        else if isDirType a then
          ''COMPREPLY=($(compgen -d -- "$cur"))''
        else if isFileType a then
          ''COMPREPLY=($(compgen -f -- "$cur"))''
        else
          ":";
      valueCases = lib.concatMap (
        level:
        map (
          a:
          "    ${level.id}:--${a.long}${
                optionalString (a.short != null) "|${level.id}:-${a.short}"
              }) ${valueAction a}; return ;;"
        ) (filter (a: a.kind == "option") (argsOf level))
      ) levels;
      levelCase =
        level:
        let
          words =
            lib.concatMap (
              a:
              [ "--${a.long}" ]
              ++ optional (a.short != null) "-${a.short}"
              ++ optional (a.kind == "flag" && a.negatable) "--no-${a.long}"
            ) (argsOf level)
            ++ optional ir.globals.help "--help"
            ++ optional (ir.globals.version && level.path == [ ]) "--version";
          cmds = lib.concatMap namesOf (commandsOf level);
          pos = visible level.positional;
          posValues = lib.concatMap (p: if p.values != null then p.values else [ ]) pos;
          dynamic = lib.findFirst (p: p.complete != null) null pos;
          files = lib.any isFileType pos;
          dirs = lib.any isDirType pos;
        in
        ''
          ${level.id})
            __scripter_opts=${q (concatStringsSep " " words)}
            __scripter_words=${q (concatStringsSep " " (cmds ++ posValues))}
            ${optionalString (
              dynamic != null
            ) ''__scripter_words="$__scripter_words $(${dynamic.complete} 2>/dev/null)"''}
            __scripter_files=${
              if files then
                "f"
              else if dirs then
                "d"
              else
                "''"
            }
            ;;'';
    in
    ''
      # bash completion for ${ir.name} — generated by nix-scripter
      ${fn}() {
        local cur prev __scripter_level=root __scripter_i __scripter_w
        local __scripter_opts="" __scripter_words="" __scripter_files=""
        cur=''${COMP_WORDS[COMP_CWORD]}
        prev=''${COMP_WORDS[COMP_CWORD-1]}
        for ((__scripter_i = 1; __scripter_i < COMP_CWORD; __scripter_i++)); do
          __scripter_w=''${COMP_WORDS[__scripter_i]}
          case "$__scripter_level:$__scripter_w" in
      ${concatStringsSep "\n" transitions}
      ${optionalString (
        valueOpts != [ ]
      ) "      ${concatStringsSep "|" valueOpts}) ((__scripter_i++)) ;;"}
          esac
        done
        case "$__scripter_level:$prev" in
      ${concatStringsSep "\n" valueCases}
        esac
        case $__scripter_level in
      ${concatMapStringsSep "\n" levelCase levels}
        esac
        if [[ $cur == -* ]]; then
          COMPREPLY=($(compgen -W "$__scripter_opts" -- "$cur"))
        else
          COMPREPLY=($(compgen -W "$__scripter_words" -- "$cur"))
          case $__scripter_files in
            f) COMPREPLY+=($(compgen -f -- "$cur")) ;;
            d) COMPREPLY+=($(compgen -d -- "$cur")) ;;
          esac
        fi
      }
      complete -F ${fn} ${q ir.name}
    '';

  # ----------------------------------------------------------------- zsh --
  zshEscape = s: lib.replaceStrings [ "\\" "[" "]" ":" "'" ] [ "\\\\" "\\[" "\\]" "\\:" "'\\''" ] s;

  zshAction =
    a:
    if a.complete or null != null then
      "{compadd -- \${(f)\"$(${lib.replaceStrings [ "'" ] [ "'\\''" ] a.complete} 2>/dev/null)\"}}"
    else if a.values or null != null then
      "(${concatStringsSep " " (map zshEscape a.values)})"
    else if isDirType a then
      "_files -/"
    else if isFileType a then
      "_files"
    else
      " ";

  zshSpec =
    a:
    let
      desc = "[${zshEscape a.description}]";
      repeat = optionalString ((a.repeated or false) || (a.count or false)) "*";
      excl = if a.short != null && repeat == "" then "'(-${a.short} --${a.long})'" else "";
      names =
        if a.kind == "option" then
          (if a.short != null then "{-${a.short}+,--${a.long}=}" else "--${a.long}=")
        else if a.short != null then
          "{-${a.short},--${a.long}}"
        else
          "--${a.long}";
      value = optionalString (a.kind == "option") ":${zshEscape a.metavar}:${zshAction a}";
      neg = optional (
        a.kind == "flag" && a.negatable
      ) "'--no-${a.long}[${zshEscape "Negate --${a.long}"}]'";
    in
    [ "${excl}${optionalString (repeat != "") "'${repeat}'"}${names}'${desc}${value}'" ] ++ neg;

  zshLevel =
    ir: level:
    let
      fn = fnName ir.name level.id;
      cmds = commandsOf level;
      pos = visible level.positional;
      posSpecs = lib.imap1 (
        i: p:
        if p.variadic then
          "'*:${zshEscape p.metavar}:${zshAction p}'"
        else
          "'${optionalString p.optional ":"}${toString i}:${zshEscape p.metavar}:${zshAction p}'"
      ) pos;
      specs =
        lib.concatMap zshSpec (argsOf level)
        ++ optional ir.globals.help "'(- *)'{-h,--help}'[Print help]'"
        ++ optional (ir.globals.version && level.path == [ ]) "'(- *)--version[Print version]'"
        ++ posSpecs
        ++ optionals' (cmds != [ ]) [
          "'1: :->command'"
          "'*:: :->args'"
        ];
      optionals' = c: xs: if c then xs else [ ];
      describeCmds = concatMapStringsSep " " (
        c:
        concatMapStringsSep " " (n: q "${n}:${lib.replaceStrings [ ":" ] [ "\\:" ] c.description}") (
          namesOf c
        )
      ) cmds;
    in
    ''
      ${fn}() {
        local context state state_descr line
        typeset -A opt_args
        _arguments -s -S -C \
          ${concatStringsSep " \\\n    " specs}
      ${optionalString (cmds != [ ]) ''
          case $state in
            command)
              local -a commands=(${describeCmds})
              _describe -t commands 'command' commands
              ;;
            args)
              case $line[1] in
        ${concatMapStringsSep "\n" (
          c: "          ${concatStringsSep "|" (namesOf c)}) ${fnName ir.name c.id} ;;"
        ) cmds}
              esac
              ;;
          esac''}
      }
    '';

  zsh = ir: ''
    #compdef ${ir.name}
    # zsh completion for ${ir.name} — generated by nix-scripter

    ${concatMapStringsSep "\n" (zshLevel ir) (levelsOf ir.root)}
    ${fnName ir.name "root"} "$@"
  '';

  # ---------------------------------------------------------------- fish --
  fish =
    ir:
    let
      levels = levelsOf ir.root;
      condition =
        level:
        let
          seen = map (n: "__fish_seen_subcommand_from ${concatStringsSep " " n}") (
            lib.genList (
              i:
              let
                l = lib.findFirst (x: x.path == lib.take (i + 1) level.path) null levels;
              in
              namesOf l
            ) (lib.length level.path)
          );
          childNames = lib.concatMap namesOf (commandsOf level);
          notChild = optional (
            childNames != [ ]
          ) "not __fish_seen_subcommand_from ${concatStringsSep " " childNames}";
          parts = seen ++ notChild;
        in
        if parts == [ ] then "" else "-n ${q (concatStringsSep "; and " parts)} ";
      c = "complete -c ${q ir.name}";
      argLine =
        cond: a:
        "${c} ${cond}${optionalString (a.short != null) "-s ${a.short} "}-l ${a.long}"
        + optionalString (a.kind == "option") (
          if a.complete != null then
            " -x -a ${q "(${a.complete} 2>/dev/null)"}"
          else if a.values != null then
            " -x -a ${q (concatStringsSep " " a.values)}"
          else if isFileType a || isDirType a then
            " -r -F"
          else
            " -x"
        )
        + optionalString (a.description != "") " -d ${q a.description}";
      levelLines =
        level:
        let
          cond = condition level;
          pos = visible level.positional;
          posValues = lib.concatMap (p: if p.values != null then p.values else [ ]) pos;
        in
        map (argLine cond) (argsOf level)
        ++ map (a: "${c} ${cond}-l no-${a.long} -d ${q "Negate --${a.long}"}") (
          filter (a: a.kind == "flag" && a.negatable) (argsOf level)
        )
        ++ optional ir.globals.help "${c} ${cond}-s h -l help -d 'Print help'"
        ++ optional (ir.globals.version && level.path == [ ]) "${c} ${cond}-l version -d 'Print version'"
        ++ map (
          sub:
          "${c} ${cond}-a ${q (concatStringsSep " " (namesOf sub))}"
          + optionalString (sub.description != "") " -d ${q sub.description}"
        ) (commandsOf level)
        ++ optional (posValues != [ ]) "${c} ${cond}-a ${q (concatStringsSep " " posValues)}"
        ++ map (p: "${c} ${cond}-a ${q "(${p.complete} 2>/dev/null)"}") (filter (p: p.complete != null) pos)
        ++ optional (lib.any (p: isFileType p || isDirType p) pos) "${c} ${cond}-F";
    in
    ''
      # fish completion for ${ir.name} — generated by nix-scripter
      ${c} -f
      ${concatStringsSep "\n" (lib.concatMap levelLines levels)}
    '';
in
{
  inherit bash zsh fish;
}
