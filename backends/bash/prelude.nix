{ lib, targets }:
let
  inherit (lib) concatStringsSep optionalString;
  q = lib.escapeShellArg;
  inherit (import ../../lib/util.nix { inherit lib; }) shellQuote;

  shebang =
    config:
    if config.mode == "linked" then
      "#!${config.bash.package}/bin/bash"
    else
      "#!${config.bash.standaloneShebang}";

  versionGuard =
    config:
    let
      version = targets.${config.bash.target}.version;
      major = toString (lib.elemAt version 0);
      minor = toString (lib.elemAt version 1);
    in
    optionalString (config.mode == "standalone") ''
      if [ -z "''${BASH_VERSION:-}" ]; then
        printf '%s: error: this script must be run with bash\n' ${q config.name} >&2
        exit 1
      fi
      if [ "''${BASH_VERSINFO[0]}" -lt ${major} ] || { [ "''${BASH_VERSINFO[0]}" -eq ${major} ] && [ "''${BASH_VERSINFO[1]}" -lt ${minor} ]; }; then
        printf '%s: error: bash >= %s is required, this is %s\n' ${q config.name} ${q config.bash.target} "$BASH_VERSION" >&2
        exit 1
      fi'';

  pathExport =
    config: linkedPath:
    let
      dirs = q (concatStringsSep ":" linkedPath);
    in
    optionalString (linkedPath != [ ]) (
      {
        prefix = ''export PATH=${dirs}"''${PATH:+:$PATH}"'';
        suffix = ''export PATH="''${PATH:+$PATH:}"${dirs}'';
        replace = "export PATH=${dirs}";
      }
      .${config.path}
    );

  missingCommandsCheck =
    config: commands:
    optionalString (commands != [ ]) ''
      __scripter_missing=""
      for __scripter_c in ${concatStringsSep " " (map q commands)}; do
        command -v "$__scripter_c" >/dev/null 2>&1 || __scripter_missing="$__scripter_missing $__scripter_c"
      done
      if [ -n "$__scripter_missing" ]; then
        printf '%s: error: missing required commands:%s\n' ${q config.name} "$__scripter_missing" >&2
        exit 127
      fi
      unset __scripter_c __scripter_missing'';

  envExports = config: lib.mapAttrsToList (n: v: "export ${n}=${q v}") config.env;

  identity = config: [
    "__scripter_name=${shellQuote config.name}"
    "__scripter_version=${shellQuote config.version}"
    "__scripter_target=${shellQuote config.bash.target}"
  ];
in
{
  render =
    {
      config,
      linkedPath,
      startupCommands,
    }:
    concatStringsSep "\n" (
      lib.filter (s: s != "") (
        [
          (shebang config)
          "# ${config.name} ${config.version}, generated by nix-scripter; do not edit"
          (optionalString config.bash.strict "set -euo pipefail")
          (versionGuard config)
          (pathExport config linkedPath)
          (missingCommandsCheck config startupCommands)
        ]
        ++ envExports config
        ++ identity config
      )
    );
}
